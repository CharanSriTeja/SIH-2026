# ============================================================
# SECRETS & ENVIRONMENT — NEVER COMMIT
# ============================================================
.env
*.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/
*.log

# ============================================================
# MASSIVE RAW DATASETS (>50MB) — NEVER COMMIT
# ============================================================
*.nc
*.duckdb
*.zip
*.parquet
*.geoparquet
*.h5
*.hdf5
*.osm*

# ============================================================
# DATA DIRECTORY RULES (relative to backend/)
# ============================================================
# By default ignore everything in data/
data/**

# Whitelist root files & folders
!data/
!data/__init__.py
!data/mdapi.py
!data/config.json
!data/states_districts.json
!data/states_districts_detailed.json

# Whitelist state boundaries (GeoJSON)
!data/NER_Boundaries/
!data/NER_Boundaries/**

# Whitelist trained ML models
!data/Models/
!data/Models/**

# Whitelist Model A COG
!data/Model 1 Datasets/
!data/Model 1 Datasets/modelA_NER_only_susceptibility_cog.tif

# Whitelist vector map tiles (PMTiles)
!data/Villages/
!data/Villages/villages_ner.pmtiles

!data/Hospitals/
!data/Hospitals/tiles/
!data/Hospitals/tiles/**

!data/Landslides Data/
!data/Landslides Data/historical_landslides.pmtiles

# Whitelist daily processed outputs & QC reports
!data/processed/
!data/processed/**

!data/soil_moisture/
!data/soil_moisture/processed/
!data/soil_moisture/processed/**
